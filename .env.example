# ── LLM API Keys (at least one required) ──────────────────────
GROQ_API_KEY=your_groq_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# ── Model Configuration (optional — defaults shown) ──────────
# DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
# DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
# DEFAULT_OPENAI_MODEL=gpt-4o-2024-08-06
# LLM_TEMPERATURE=0.1
# LLM_MAX_RETRIES=2

# ── Embeddings (optional — defaults to OpenAI if key set) ────
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ── RapidAPI for LinkedIn scraping (optional) ────────────────
RAPIDAPI_KEY=your_rapidapi_key_here

# ── LangSmith Observability (optional) ───────────────────────
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=hr-shortlisting-agent

# ── Application Security ─────────────────────────────────────
AGENT_API_KEY=your_internal_api_key_here
ALLOWED_ORIGINS=*
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── File Processing ──────────────────────────────────────────
MAX_FILE_SIZE_MB=10
MAX_CANDIDATES_PER_RUN=50

# ── Cache Configuration ──────────────────────────────────────
ENABLE_CACHE=true
CACHE_DB_PATH=./cache/langchain_cache.db

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
